# Entra ID app registration (application permissions, client-secret auth for now)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Comma-separated list of the org's own email domains (used for internal/external tagging)
# Example: INTERNAL_DOMAINS=acme.com,acme.co.uk
INTERNAL_DOMAINS=

# PostgreSQL connection for crawl_jobs / items tables
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/m365_intel
